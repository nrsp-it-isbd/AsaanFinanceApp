<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:tools="http://schemas.android.com/tools" xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@drawable/bg_login_gradient">

    <!-- Top Header Bar -->
    <RelativeLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingTop="28dp"
        android:paddingBottom="14dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_arrow_back"
            android:padding="8dp"
            android:background="@drawable/bg_pill_grey"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true" 
            tools:ignore="ContentDescription" />

        <TextView
            android:id="@+id/tvHeaderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="@string/str_edit_profile"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/auto_color_1F2937" 
            tools:ignore="SmallSp,SpUsage" />

        <ImageView
            android:id="@+id/btnEditTop"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_pill_grey"
            android:padding="8dp"
            android:src="@drawable/ic_edit"
            app:tint="@color/navy_blue"
            tools:ignore="ContentDescription" />
    </RelativeLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/SVParent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
        android:baselineAligned="false">

            <LinearLayout
                android:id="@+id/headerSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="12dp"
        android:baselineAligned="false">

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
        tools:ignore="UnusedAttribute">

                    <de.hdodenhof.circleimageview.CircleImageView
                        android:id="@+id/ivProfilePic"
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:src="@drawable/dummy_profile_image"
                        app:civ_border_color="@color/border_slate_100"
                        app:civ_border_width="4dp" />

                    <com.google.android.material.floatingactionbutton.FloatingActionButton
                        android:id="@+id/btnChangePhoto"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|end"
                        android:layout_margin="-8dp"
                        app:backgroundTint="@color/primary"
                        app:fabCustomSize="28dp"
                        app:maxImageSize="14dp"
                        app:srcCompat="@drawable/ic_camera"
                        app:tint="@color/white" 
        tools:ignore="ContentDescription" />
                </FrameLayout>

                <TextView
                    android:id="@+id/txtName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.05"
                    android:text="@string/str_assan_user"
                    android:textColor="@color/primary"
                    android:textSize="22sp" 
        tools:ignore="SmallSp,SpUsage" />

                <TextView
                    android:id="@+id/txtAssanId"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/str_assan_id_12345"
                    android:textColor="@color/text_slate_400"
                    android:textSize="14sp"
                    android:textStyle="bold" 
        tools:ignore="SmallSp,SpUsage" />

                <TextView
                    android:id="@+id/txtUsername"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/str_username"
                    android:textColor="@color/text_slate_400"
                    android:textSize="12sp"
        tools:ignore="SmallSp,SpUsage" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/formCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="32dp"
        android:baselineAligned="false">

                <!-- Full Name -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.05"
                    android:text="@string/str_full_name"
                    android:textColor="@color/light_gray_label"
                    android:textSize="11sp"
                    android:textStyle="bold" 
        tools:ignore="SmallSp,SpUsage" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_input_field_selector"
                    android:paddingHorizontal="16dp">

                    <ImageView
                        android:id="@+id/ivFullNameIcon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:src="@drawable/ic_user"
                        app:tint="@color/light_gray_label" 
        tools:ignore="ContentDescription" />

                    <EditText
                        android:id="@+id/edFullName"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_toEndOf="@id/ivFullNameIcon"
                        android:layout_marginStart="12dp"
                        android:background="@android:color/transparent"
                        android:enabled="false"
                        android:hint="@string/str_full_name"
                        android:inputType="textCapWords"
                        android:paddingVertical="12dp"
                        android:textColor="@color/dark_navy"
                        android:textColorHint="@color/light_gray_label"
                        android:textSize="15sp" />
                </RelativeLayout>

                <!-- Phone Number -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.05"
                    android:text="@string/str_phone_number"
                    android:textColor="@color/light_gray_label"
                    android:textSize="11sp"
                    android:textStyle="bold" 
        tools:ignore="SmallSp,SpUsage" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_input_field_selector"
                    android:paddingHorizontal="16dp">

                    <ImageView
                        android:id="@+id/ivPhoneIcon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:src="@drawable/ic_phone"
                        app:tint="@color/light_gray_label" 
        tools:ignore="ContentDescription" />

                    <EditText
                        android:id="@+id/edPhoneNumber"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_toEndOf="@id/ivPhoneIcon"
                        android:layout_marginStart="12dp"
                        android:background="@android:color/transparent"
                        android:enabled="false"
                        android:hint="@string/str_phone_number"
                        android:inputType="phone"
                        android:maxLength="12"
                        android:paddingVertical="12dp"
                        android:textColor="@color/dark_navy"
                        android:textColorHint="@color/light_gray_label"
                        android:textSize="15sp" />
                </RelativeLayout>

                <!-- CNIC -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.05"
                    android:text="@string/str_cnic_number"
                    android:textColor="@color/light_gray_label"
                    android:textSize="11sp"
                    android:textStyle="bold" 
        tools:ignore="SmallSp,SpUsage" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_input_field_selector"
                    android:paddingHorizontal="16dp">

                    <ImageView
                        android:id="@+id/ivCnicIcon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:src="@drawable/ic_cnic"
                        app:tint="@color/light_gray_label" 
        tools:ignore="ContentDescription" />

                    <EditText
                        android:id="@+id/edCNICNumber"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_toEndOf="@id/ivCnicIcon"
                        android:layout_marginStart="12dp"
                        android:background="@android:color/transparent"
                        android:enabled="false"
                        android:hint="@string/str_cnic_number"
                        android:inputType="phone"
                        android:maxLength="15"
                        android:paddingVertical="12dp"
                        android:textColor="@color/dark_navy"
                        android:textColorHint="@color/light_gray_label"
                        android:textSize="15sp" />
                </RelativeLayout>

                <!-- Date of Birth -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.05"
                    android:text="@string/str_date_of_birth"
                    android:textColor="@color/light_gray_label"
                    android:textSize="11sp"
                    android:textStyle="bold" 
        tools:ignore="SmallSp,SpUsage" />

                <RelativeLayout
                    android:id="@+id/layoutDob"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="24dp"
                    android:background="@drawable/bg_input_field_selector"
                    android:paddingHorizontal="16dp">

                    <ImageView
                        android:id="@+id/ivDobIcon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:src="@drawable/ic_calendar_month"
                        app:tint="@color/light_gray_label" 
        tools:ignore="ContentDescription" />

                    <EditText
                        android:id="@+id/edDateOfBirth"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_toEndOf="@id/ivDobIcon"
                        android:layout_marginStart="12dp"
                        android:background="@android:color/transparent"
                        android:enabled="false"
                        android:focusable="false"
                        android:clickable="true"
                        android:cursorVisible="false"
                        android:hint="@string/str_date_of_birth"
                        android:paddingVertical="12dp"
                        android:textColor="@color/dark_navy"
                        android:textColorHint="@color/light_gray_label"
                        android:textSize="15sp" />
                </RelativeLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/auto_color_E0E0E0"
                    android:layout_marginBottom="24dp"/>

                <!-- Old Password -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.05"
                    android:text="@string/auto_old_password_863"
                    android:textColor="@color/light_gray_label"
                    android:textSize="11sp"
                    android:textStyle="bold" 
        tools:ignore="SmallSp,SpUsage" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_input_field_selector"
                    android:paddingHorizontal="16dp">

                    <ImageView
                        android:id="@+id/ivOldPassIcon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:src="@drawable/ic_key"
                        app:tint="@color/light_gray_label" 
        tools:ignore="ContentDescription" />

                    <EditText
                        android:id="@+id/edOldPassword"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_toEndOf="@id/ivOldPassIcon"
                        android:layout_marginStart="12dp"
                        android:background="@android:color/transparent"
                        android:enabled="false"
                        android:hint="@string/auto_old_password_optional_867"
                        android:inputType="textPassword"
                        android:paddingVertical="12dp"
                        android:textColor="@color/dark_navy"
                        android:textColorHint="@color/light_gray_label"
                        android:textSize="15sp" />
                </RelativeLayout>

                <!-- New Password -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.05"
                    android:text="@string/auto_new_password_864"
                    android:textColor="@color/light_gray_label"
                    android:textSize="11sp"
                    android:textStyle="bold" 
        tools:ignore="SmallSp,SpUsage" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_input_field_selector"
                    android:paddingHorizontal="16dp">

                    <ImageView
                        android:id="@+id/ivNewPassIcon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:src="@drawable/ic_key"
                        app:tint="@color/light_gray_label" 
        tools:ignore="ContentDescription" />

                    <EditText
                        android:id="@+id/edNewPassword"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_toEndOf="@id/ivNewPassIcon"
                        android:layout_marginStart="12dp"
                        android:background="@android:color/transparent"
                        android:enabled="false"
                        android:hint="@string/auto_new_password_optional_868"
                        android:inputType="textPassword"
                        android:paddingVertical="12dp"
                        android:textColor="@color/dark_navy"
                        android:textColorHint="@color/light_gray_label"
                        android:textSize="15sp" />
                </RelativeLayout>

                <!-- Confirm New Password -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.05"
                    android:text="@string/auto_confirm_new_password_865"
                    android:textColor="@color/light_gray_label"
                    android:textSize="11sp"
                    android:textStyle="bold" 
        tools:ignore="SmallSp,SpUsage" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_input_field_selector"
                    android:paddingHorizontal="16dp">

                    <ImageView
                        android:id="@+id/ivConfirmPassIcon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:src="@drawable/ic_key"
                        app:tint="@color/light_gray_label" 
        tools:ignore="ContentDescription" />

                    <EditText
                        android:id="@+id/edNewConfirmPassword"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_toEndOf="@id/ivConfirmPassIcon"
                        android:layout_marginStart="12dp"
                        android:background="@android:color/transparent"
                        android:enabled="false"
                        android:hint="@string/auto_confirm_new_password_opti_869"
                        android:inputType="textPassword"
                        android:paddingVertical="12dp"
                        android:textColor="@color/dark_navy"
                        android:textColorHint="@color/light_gray_label"
                        android:textSize="15sp" />
                </RelativeLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/updateProfileButton"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="28dp"
                    android:layout_marginBottom="24dp"
                    android:enabled="false"
                    android:text="@string/auto_update_data_866"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/primary"
                    app:cornerRadius="100dp"
                    app:elevation="2dp" />

            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
