<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:tools="http://schemas.android.com/tools" xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="3dp"
    app:cardCornerRadius="@dimen/_8sdp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/_16sdp"
        android:gravity="center_vertical"
        android:background="?attr/selectableItemBackground"
        android:baselineAligned="false">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/download_file"
            app:tint="@color/colorPrimary" 
        tools:ignore="ContentDescription" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="16dp"
        android:baselineAligned="false">

            <TextView
                android:id="@+id/tvFileName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/auto_ledger_20230101_pdf_871"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/black" 
        tools:ignore="SmallSp,SpUsage" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp"
        android:baselineAligned="false">

                <TextView
                    android:id="@+id/tvFileDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/auto_12_jan_2023_872"
                    android:textSize="12sp"
                    android:textColor="@color/auto_color_888888" 
        tools:ignore="SmallSp,SpUsage" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/auto_str_873"
                    android:textSize="12sp"
                    android:textColor="@color/auto_color_888888" 
        tools:ignore="SmallSp,SpUsage" />

                <TextView
                    android:id="@+id/tvFileSize"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/auto_1_2_mb_874"
                    android:textSize="12sp"
                    android:textColor="@color/auto_color_888888" 
        tools:ignore="SmallSp,SpUsage" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
        android:baselineAligned="false">

            <ImageView
                android:id="@+id/btnShareFile"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/baseline_share_24"
                android:padding="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="@color/auto_color_558B2F" 
        tools:ignore="ContentDescription" />
                
            <ImageView
                android:id="@+id/btnDeleteFile"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginTop="4dp"
                android:src="@drawable/baseline_delete_24"
                android:padding="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="@color/auto_color_D32F2F" 
        tools:ignore="ContentDescription" />
        </LinearLayout>
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
