<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:tools="http://schemas.android.com/tools" xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:padding="20dp"
        android:baselineAligned="false">

    <!-- Header for Year Selection -->
    <RelativeLayout
        android:id="@+id/rlYearHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="@string/auto_select_range_808"
            android:textColor="@color/black"
            android:textSize="18sp"
            android:textStyle="bold" 
        tools:ignore="SmallSp,SpUsage" />

        <ImageView
            android:id="@+id/btnCloseYear"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_close"
            app:tint="@color/black" 
        tools:ignore="ContentDescription" />
    </RelativeLayout>

    <!-- Header for Calendar Selection -->
    <RelativeLayout
        android:id="@+id/rlCalendarHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/btnBackToYear"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/black" 
        tools:ignore="ContentDescription" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="@string/auto_range_selected_809"
            android:textColor="@color/black"
            android:textSize="18sp"
            android:textStyle="bold" 
        tools:ignore="SmallSp,SpUsage" />

        <ImageView
            android:id="@+id/btnCloseCalendar"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_close"
            app:tint="@color/black" 
        tools:ignore="ContentDescription" />
    </RelativeLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/auto_color_F3F4F6"
        android:layout_marginBottom="16dp" />

    <ViewFlipper
        android:id="@+id/viewFlipper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Screen 1: Year Selection -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvYears"
            android:layout_width="match_parent"
            android:layout_height="350dp"
            android:clipToPadding="false" />

        <!-- Screen 2: Calendar Selection -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
        android:baselineAligned="false">

            <!-- Month Navigator -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:id="@+id/btnPrevMonth"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_alignParentStart="true"
                    android:padding="8dp"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="@color/black" 
        tools:ignore="ContentDescription" />

                <TextView
                    android:id="@+id/tvCurrentMonth"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:text="@string/auto_july_2026_810"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    android:textStyle="bold" 
        tools:ignore="SmallSp,SpUsage" />

                <ImageView
                    android:id="@+id/btnNextMonth"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_alignParentEnd="true"
                    android:padding="8dp"
                    android:src="@drawable/ic_arrow_right"
                    app:tint="@color/black" 
        tools:ignore="ContentDescription" />
            </RelativeLayout>

            <!-- Days of Week Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="7"
                android:layout_marginBottom="8dp"
        android:baselineAligned="false">

                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/auto_s_811" android:gravity="center" android:textColor="@color/auto_color_6B7280" 
        tools:ignore="SmallSp,SpUsage" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/auto_m_812" android:gravity="center" android:textColor="@color/auto_color_6B7280" 
        tools:ignore="SmallSp,SpUsage" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/auto_t_813" android:gravity="center" android:textColor="@color/auto_color_6B7280" 
        tools:ignore="SmallSp,SpUsage" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/auto_w_814" android:gravity="center" android:textColor="@color/auto_color_6B7280" 
        tools:ignore="SmallSp,SpUsage" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/auto_t_813" android:gravity="center" android:textColor="@color/auto_color_6B7280" 
        tools:ignore="SmallSp,SpUsage" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/auto_f_815" android:gravity="center" android:textColor="@color/auto_color_6B7280" 
        tools:ignore="SmallSp,SpUsage" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/auto_s_811" android:gravity="center" android:textColor="@color/auto_color_6B7280" 
        tools:ignore="SmallSp,SpUsage" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvCalendar"
                android:layout_width="match_parent"
                android:layout_height="250dp"
                android:clipToPadding="false" />

            <!-- Bottom Actions -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:paddingTop="16dp">

                <TextView
                    android:id="@+id/btnClearDates"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:text="@string/auto_clear_dates_816"
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    android:textStyle="bold" 
        tools:ignore="SmallSp,SpUsage" />

                <TextView
                    android:id="@+id/btnSave"
                    android:layout_width="100dp"
                    android:layout_height="40dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/bg_btn_green_rounded"
                    android:gravity="center"
                    android:text="@string/save"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold" 
        tools:ignore="SmallSp,SpUsage" />
            </RelativeLayout>

        </LinearLayout>
    </ViewFlipper>

</LinearLayout>
