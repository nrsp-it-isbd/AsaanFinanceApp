<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:tools="http://schemas.android.com/tools" xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="@drawable/bg_login_gradient"
        android:baselineAligned="false">

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingTop="24dp"
        android:paddingBottom="16dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_arrow_back"
            android:padding="8dp"
            android:background="@drawable/bg_pill_grey"
            android:layout_centerVertical="true" 
        tools:ignore="ContentDescription" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="@string/str_notifications"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/auto_color_1F2937" 
        tools:ignore="SmallSp,SpUsage" />

        <TextView
            android:id="@+id/tvMarkRead"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:text="@string/str_mark_all_as_read"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="@color/auto_color_1F2937" 
        tools:ignore="SmallSp,SpUsage" />
    </RelativeLayout>

    <!-- Filter Chips -->
    <HorizontalScrollView
        android:id="@+id/hsvFilters"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingHorizontal="20dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
        android:baselineAligned="false">

            <!-- Row 1 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:orientation="horizontal"
        android:baselineAligned="false">

                <TextView
                    android:id="@+id/chipAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/str_all"
                    android:textColor="@color/auto_color_10B981"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="6dp"
                    android:background="@drawable/bg_chip_selected"
                    android:layout_marginEnd="8dp" 
        tools:ignore="SmallSp,SpUsage" />

                <TextView
                    android:id="@+id/chipUnread"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/auto_unread_686"
                    android:textColor="@color/auto_color_6B7280"
                    android:textSize="12sp"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="6dp"
                    android:background="@drawable/bg_pill_grey"
                    android:layout_marginEnd="8dp" 
        tools:ignore="SmallSp,SpUsage" />

                <TextView
                    android:id="@+id/chipRead"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/auto_read_687"
                    android:textColor="@color/auto_color_6B7280"
                    android:textSize="12sp"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="6dp"
                    android:background="@drawable/bg_pill_grey"
                    android:layout_marginEnd="8dp" 
        tools:ignore="SmallSp,SpUsage" />
                    
                <TextView
                    android:id="@+id/chipGeneral"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/auto_general_688"
                    android:textColor="@color/auto_color_6B7280"
                    android:textSize="12sp"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="6dp"
                    android:background="@drawable/bg_pill_grey"
                    android:layout_marginEnd="8dp" 
        tools:ignore="SmallSp,SpUsage" />

                <TextView
                    android:id="@+id/chipRecovery"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/auto_recovery_689"
                    android:textColor="@color/auto_color_6B7280"
                    android:textSize="12sp"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="6dp"
                    android:background="@drawable/bg_pill_grey"
                    android:layout_marginEnd="8dp" 
        tools:ignore="SmallSp,SpUsage" />
                    
                <TextView
                    android:id="@+id/chipInstallment"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/auto_installment_690"
                    android:textColor="@color/auto_color_6B7280"
                    android:textSize="12sp"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="6dp"
                    android:background="@drawable/bg_pill_grey"
                    android:layout_marginEnd="8dp" 
        tools:ignore="SmallSp,SpUsage" />
            </LinearLayout>

            <!-- Row 2 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
        android:baselineAligned="false">

                <TextView
                    android:id="@+id/chipLoan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/auto_loan_691"
                    android:textColor="@color/auto_color_6B7280"
                    android:textSize="12sp"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="6dp"
                    android:background="@drawable/bg_pill_grey"
                    android:layout_marginEnd="8dp" 
        tools:ignore="SmallSp,SpUsage" />

                <TextView
                    android:id="@+id/chipPayment"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/auto_payment_692"
                    android:textColor="@color/auto_color_6B7280"
                    android:textSize="12sp"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="6dp"
                    android:background="@drawable/bg_pill_grey"
                    android:layout_marginEnd="8dp" 
        tools:ignore="SmallSp,SpUsage" />

                <TextView
                    android:id="@+id/chipApproved"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/auto_approved_693"
                    android:textColor="@color/auto_color_6B7280"
                    android:textSize="12sp"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="6dp"
                    android:background="@drawable/bg_pill_grey"
                    android:layout_marginEnd="8dp" 
        tools:ignore="SmallSp,SpUsage" />

                <TextView
                    android:id="@+id/chipRejected"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/auto_rejected_694"
                    android:textColor="@color/auto_color_6B7280"
                    android:textSize="12sp"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="6dp"
                    android:background="@drawable/bg_pill_grey"
                    android:layout_marginEnd="8dp" 
        tools:ignore="SmallSp,SpUsage" />

                <TextView
                    android:id="@+id/chipFeedback"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/feedback"
                    android:textColor="@color/auto_color_6B7280"
                    android:textSize="12sp"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="6dp"
                    android:background="@drawable/bg_pill_grey"
                    android:layout_marginEnd="8dp" 
        tools:ignore="SmallSp,SpUsage" />
                    
                <TextView
                    android:id="@+id/chipPromotion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/auto_promotion_695"
                    android:textColor="@color/auto_color_6B7280"
                    android:textSize="12sp"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="6dp"
                    android:background="@drawable/bg_pill_grey"
                    android:layout_marginEnd="8dp" 
        tools:ignore="SmallSp,SpUsage" />

                <TextView
                    android:id="@+id/chipCOC"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/str_coc"
                    android:textColor="@color/auto_color_6B7280"
                    android:textSize="12sp"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="6dp"
                    android:background="@drawable/bg_pill_grey"
                    android:layout_marginEnd="8dp" 
        tools:ignore="SmallSp,SpUsage" />

                <TextView
                    android:id="@+id/chipBT"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/str_bt"
                    android:textColor="@color/auto_color_6B7280"
                    android:textSize="12sp"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="6dp"
                    android:background="@drawable/bg_pill_grey"
                    android:layout_marginEnd="8dp" 
        tools:ignore="SmallSp,SpUsage" />

                <TextView
                    android:id="@+id/chipClosedLoan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/str_closed_loan"
                    android:textColor="@color/auto_color_6B7280"
                    android:textSize="12sp"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="6dp"
                    android:background="@drawable/bg_pill_grey"
                    android:layout_marginEnd="8dp" 
        tools:ignore="SmallSp,SpUsage" />
            </LinearLayout>

        </LinearLayout>
    </HorizontalScrollView>

    <RelativeLayout
        android:id="@+id/rlTodayHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/tvToday"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/str_today"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/auto_color_1F2937"
            android:layout_centerVertical="true" 
        tools:ignore="SmallSp,SpUsage" />

        <TextView
            android:id="@+id/chipDateRange"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:text="@string/auto_date_range_696"
            android:gravity="center"
            app:drawableStartCompat="@drawable/ic_calendar_small"
            app:drawableTint="@color/auto_color_6B7280"
            android:drawablePadding="6dp"
            android:textColor="@color/auto_color_6B7280"
            android:textSize="12sp"
            android:textStyle="normal"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:background="@drawable/bg_pill_grey" 
        tools:ignore="SmallSp,SpUsage" />
    </RelativeLayout>

    <!-- FIX: the refresh list filled all the space, so the empty state below it was pushed off-screen.
         Shimmer, list and empty state now share one area. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/shimmerNotifications"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:shimmer_auto_start="true">
            <include layout="@layout/layout_shimmer_notification" />
        </com.facebook.shimmer.ShimmerFrameLayout>

        <!-- Pull to refresh works on the list and on the empty message -->
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefreshLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvNotifications"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:paddingHorizontal="20dp"
                        android:clipToPadding="false"
                        android:visibility="gone"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

                <androidx.core.widget.NestedScrollView
                    android:id="@+id/svEmptyState"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fillViewport="true"
                    android:visibility="gone">

                <LinearLayout
                    android:id="@+id/llEmptyState"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:paddingBottom="120dp"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:baselineAligned="false">

                    <ImageView
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:src="@drawable/ic_bell"
                        android:alpha="0.2"
                        app:tint="@color/auto_color_6B7280" 
                    tools:ignore="ContentDescription" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/auto_no_recovery_notifications_697"
                        android:textColor="@color/auto_color_6B7280"
                        android:textSize="18sp"
                        android:textStyle="bold" 
                    tools:ignore="SmallSp,SpUsage" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:paddingHorizontal="40dp"
                        android:text="@string/auto_you_will_see_a_notificati_698"
                        android:textColor="@color/auto_color_9CA3AF"
                        android:textSize="14sp" 
                    tools:ignore="SmallSp,SpUsage" />
                </LinearLayout>
                </androidx.core.widget.NestedScrollView>
            </FrameLayout>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    </FrameLayout>

</LinearLayout>
