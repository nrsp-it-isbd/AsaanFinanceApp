<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_login_gradient">

    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_margin="16dp"
        android:visibility="gone"
        android:background="?selectableItemBackgroundBorderless"
        android:src="@drawable/ic_baseline_arrow_back_24"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/navy_blue" 
        tools:ignore="ContentDescription" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/SVParent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
        android:baselineAligned="false">

            <LinearLayout
                android:id="@+id/logoCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="48dp"
                android:gravity="center"
                android:orientation="vertical"
        android:baselineAligned="false">

                <ImageView
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:padding="10dp"
                    android:src="@drawable/logo" 
        tools:ignore="ContentDescription" />

                <TextView
                    android:id="@+id/txtWelcome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="sans-serif-black"
                    android:text="@string/str_change_password"
                    android:textColor="@color/primary"
                    android:textSize="24sp"
                    android:letterSpacing="0.05" 
        tools:ignore="SmallSp,SpUsage" />

                <TextView
                    android:id="@+id/txtSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/str_update_your_account_"
                    android:textColor="@color/text_slate_400"
                    android:textSize="14sp"
                    android:textStyle="bold" 
        tools:ignore="SmallSp,SpUsage" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/formCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="32dp"
        android:baselineAligned="false">

                <!-- Old Password -->
                <!-- Extracted Hint Label -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/str_old_password"
        android:textColor="@color/light_gray_label"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.05" 
        tools:ignore="SmallSp,SpUsage" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_input_field_selector"
        android:paddingHorizontal="16dp">

        <EditText
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:hint="@string/str_old_password"
            android:textColorHint="@color/light_gray_label"
            android:textColor="@color/dark_navy"
            android:textSize="15sp"
            android:paddingVertical="12dp"
            android:id="@+id/edOldPassword"
                        
                        android:inputType="textPassword"
                        android:paddingStart="0dp"
                        
                         />
    </RelativeLayout>



                <!-- New Password -->
                <!-- Extracted Hint Label -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/str_new_password"
        android:textColor="@color/light_gray_label"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.05" 
        tools:ignore="SmallSp,SpUsage" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_input_field_selector"
        android:paddingHorizontal="16dp">

        <EditText
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:hint="@string/str_new_password"
            android:textColorHint="@color/light_gray_label"
            android:textColor="@color/dark_navy"
            android:textSize="15sp"
            android:paddingVertical="12dp"
            android:id="@+id/edNewPassword"
                        
                        android:inputType="textPassword"
                        android:paddingStart="0dp"
                        
                         />
    </RelativeLayout>



                <!-- Confirm Password -->
                <!-- Extracted Hint Label -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/str_confirm_password"
        android:textColor="@color/light_gray_label"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.05" 
        tools:ignore="SmallSp,SpUsage" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_input_field_selector"
        android:paddingHorizontal="16dp">

        <EditText
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:hint="@string/str_confirm_password"
            android:textColorHint="@color/light_gray_label"
            android:textColor="@color/dark_navy"
            android:textSize="15sp"
            android:paddingVertical="12dp"
            android:id="@+id/edNewConfirmPassword"
                        
                        android:inputType="textPassword"
                        android:paddingStart="0dp"
                        
                         />
    </RelativeLayout>


                <com.google.android.material.button.MaterialButton
                    android:id="@+id/updatePasswordButton"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:layout_marginTop="40dp"
                    app:backgroundTint="@color/primary"
                    android:text="@string/str_update_password"
                    app:cornerRadius="16dp"
                    app:elevation="0dp" />

            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
