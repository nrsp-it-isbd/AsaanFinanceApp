<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:tools="http://schemas.android.com/tools" xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/auto_color_F9FAFB"
        android:baselineAligned="false">

    <!-- Summary Hero Card Skeleton -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="@color/auto_color_E5E7EB"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp" />

    <!-- Ledger Receipts Table Card Skeleton -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/auto_color_E5E7EB"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
        android:baselineAligned="false">

            <!-- Title Line -->
            <View
                android:layout_width="100dp"
                android:layout_height="16dp"
                android:layout_marginBottom="16dp"
                android:background="@color/auto_color_E5E7EB" />

            <!-- Row 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp"
        android:baselineAligned="false">
                <View android:layout_width="0dp" android:layout_height="12dp" android:layout_weight="1.2" android:background="@color/auto_color_E5E7EB" android:layout_marginEnd="8dp"/>
                <View android:layout_width="0dp" android:layout_height="12dp" android:layout_weight="1" android:background="@color/auto_color_E5E7EB" android:layout_marginEnd="8dp"/>
                <View android:layout_width="0dp" android:layout_height="12dp" android:layout_weight="1.2" android:background="@color/auto_color_E5E7EB" android:layout_marginEnd="8dp"/>
                <View android:layout_width="0dp" android:layout_height="12dp" android:layout_weight="1" android:background="@color/auto_color_E5E7EB" android:layout_marginEnd="8dp"/>
                <View android:layout_width="0dp" android:layout_height="12dp" android:layout_weight="1.2" android:background="@color/auto_color_E5E7EB"/>
            </LinearLayout>

            <!-- Row 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp"
        android:baselineAligned="false">
                <View android:layout_width="0dp" android:layout_height="12dp" android:layout_weight="1.2" android:background="@color/auto_color_E5E7EB" android:layout_marginEnd="8dp"/>
                <View android:layout_width="0dp" android:layout_height="12dp" android:layout_weight="1" android:background="@color/auto_color_E5E7EB" android:layout_marginEnd="8dp"/>
                <View android:layout_width="0dp" android:layout_height="12dp" android:layout_weight="1.2" android:background="@color/auto_color_E5E7EB" android:layout_marginEnd="8dp"/>
                <View android:layout_width="0dp" android:layout_height="12dp" android:layout_weight="1" android:background="@color/auto_color_E5E7EB" android:layout_marginEnd="8dp"/>
                <View android:layout_width="0dp" android:layout_height="12dp" android:layout_weight="1.2" android:background="@color/auto_color_E5E7EB"/>
            </LinearLayout>

            <!-- Row 3 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
        android:baselineAligned="false">
                <View android:layout_width="0dp" android:layout_height="12dp" android:layout_weight="1.2" android:background="@color/auto_color_E5E7EB" android:layout_marginEnd="8dp"/>
                <View android:layout_width="0dp" android:layout_height="12dp" android:layout_weight="1" android:background="@color/auto_color_E5E7EB" android:layout_marginEnd="8dp"/>
                <View android:layout_width="0dp" android:layout_height="12dp" android:layout_weight="1.2" android:background="@color/auto_color_E5E7EB" android:layout_marginEnd="8dp"/>
                <View android:layout_width="0dp" android:layout_height="12dp" android:layout_weight="1" android:background="@color/auto_color_E5E7EB" android:layout_marginEnd="8dp"/>
                <View android:layout_width="0dp" android:layout_height="12dp" android:layout_weight="1.2" android:background="@color/auto_color_E5E7EB"/>
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Channels Label Skeleton -->
    <View
        android:layout_width="200dp"
        android:layout_height="16dp"
        android:layout_marginBottom="6dp"
        android:background="@color/auto_color_E5E7EB" />
    <View
        android:layout_width="140dp"
        android:layout_height="12dp"
        android:layout_marginBottom="16dp"
        android:background="@color/auto_color_E5E7EB" />

    <!-- Agents/Banks Section Skeleton -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="16dp"
        android:paddingVertical="12dp"
        android:baselineAligned="false">

        <!-- Title Line -->
        <View
            android:layout_width="80dp"
            android:layout_height="14dp"
            android:layout_marginBottom="16dp"
            android:background="@color/auto_color_E5E7EB" />

        <!-- Grid Items -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
        android:baselineAligned="false">
            <!-- Grid item 1 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
        android:baselineAligned="false">
                <View android:layout_width="48dp" android:layout_height="48dp" android:background="@color/auto_color_E5E7EB" android:layout_marginBottom="8dp"/>
                <View android:layout_width="40dp" android:layout_height="10dp" android:background="@color/auto_color_E5E7EB"/>
            </LinearLayout>
            <!-- Grid item 2 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
        android:baselineAligned="false">
                <View android:layout_width="48dp" android:layout_height="48dp" android:background="@color/auto_color_E5E7EB" android:layout_marginBottom="8dp"/>
                <View android:layout_width="40dp" android:layout_height="10dp" android:background="@color/auto_color_E5E7EB"/>
            </LinearLayout>
            <!-- Grid item 3 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
        android:baselineAligned="false">
                <View android:layout_width="48dp" android:layout_height="48dp" android:background="@color/auto_color_E5E7EB" android:layout_marginBottom="8dp"/>
                <View android:layout_width="40dp" android:layout_height="10dp" android:background="@color/auto_color_E5E7EB"/>
            </LinearLayout>
            <!-- Grid item 4 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
        android:baselineAligned="false">
                <View android:layout_width="48dp" android:layout_height="48dp" android:background="@color/auto_color_E5E7EB" android:layout_marginBottom="8dp"/>
                <View android:layout_width="40dp" android:layout_height="10dp" android:background="@color/auto_color_E5E7EB"/>
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
