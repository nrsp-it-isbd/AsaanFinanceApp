<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:tools="http://schemas.android.com/tools" xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="24dp"
    android:background="@android:color/transparent"
        tools:ignore="UnusedAttribute">

<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_voice_chat_dialog"
    android:padding="24dp"
    android:clipToOutline="true">

    <!-- ✅ Success Icon Circle -->
    <FrameLayout
        android:id="@+id/cvIcon"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:background="@drawable/circle_bg"
        android:backgroundTint="@color/auto_color_D7F2DC"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:ignore="UnusedAttribute">

        <!-- Lottie animation (kept for Java cast compatibility, acts as image view if raw res not found) -->
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/lottieAnimationView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="14dp"
            android:src="@drawable/ic_shield_check"
            app:tint="@color/primary"
            app:lottie_autoPlay="false"
            app:lottie_loop="false" />
    </FrameLayout>

    <!-- Title -->
    <TextView
        android:id="@+id/tvDialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/str_success"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/auto_color_1F2937"
        android:gravity="center"
        android:fontFamily="sans-serif-medium"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/cvIcon" 
        tools:ignore="SmallSp,SpUsage" />

    <!-- Message -->
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/txtMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/loan_applied_successfully"
        android:textSize="14sp"
        android:textColor="@color/subtitle"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/tvDialogTitle" />

    <!-- Close Button -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/okButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="@string/close"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:gravity="center"
        android:background="@drawable/bg_badge_rounded"
        android:backgroundTint="@color/primary"
        android:textAllCaps="false"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/txtMessage"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>
