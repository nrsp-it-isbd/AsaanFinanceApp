<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:tools="http://schemas.android.com/tools" xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="24dp"
    android:background="@android:color/transparent"
        tools:ignore="UnusedAttribute">

<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_voice_chat_dialog"
    android:padding="24dp"
    android:clipToOutline="true">

    <!-- About Icon Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cvIcon"
        android:layout_width="56dp"
        android:layout_height="56dp"
        app:cardCornerRadius="28dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/auto_color_E8F5E9"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerInside"

            android:src="@drawable/logo_transparent" 
        tools:ignore="ContentDescription" />
    </androidx.cardview.widget.CardView>

    <!-- Language Switch -->
    <LinearLayout
        android:id="@+id/llLanguageSwitch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="16dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/cvIcon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:baselineAligned="false">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/auto_english_700"
            android:textSize="14sp"
            android:textColor="@color/dark_navy"
        tools:ignore="SmallSp,SpUsage" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchLanguage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            app:thumbTint="@color/primary"
            app:trackTint="@color/auto_color_B0BEC5" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/str__1"
            android:fontFamily="@font/urdufont"
            android:textSize="16sp"
            android:textColor="@color/dark_navy"
        tools:ignore="SmallSp,SpUsage" />
    </LinearLayout>

    <!-- Dialog Title -->
    <TextView
        android:id="@+id/tvDialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/auto_assan_finance_introductio_699"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/auto_color_1F2937"
        android:gravity="center"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/llLanguageSwitch" 
        tools:ignore="SmallSp,SpUsage" />

    <!-- Dialog Scrollable Message -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/SVParent"
        android:layout_width="match_parent"
        android:layout_height="420dp"
        android:layout_marginTop="12dp"
        android:scrollbars="none"
        android:fadeScrollbars="false"
        app:layout_constraintTop_toBottomOf="@id/tvDialogTitle">

        <TextView
            android:id="@+id/aboutUsTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="5dp"
            android:textColor="@color/text_slate_500"
            android:textSize="14sp"
            android:gravity="start" 
        tools:ignore="SmallSp,SpUsage" />
    </androidx.core.widget.NestedScrollView>

    <!-- Close Button -->
    <TextView
        android:id="@+id/btnBack"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="@string/close"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:gravity="center"
        android:background="@drawable/bg_badge_rounded"
        android:backgroundTint="@color/primary"
        android:clickable="true"
        android:focusable="true"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/SVParent"
        app:layout_constraintBottom_toBottomOf="parent" 
        tools:ignore="SmallSp,SpUsage" />

</androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>
