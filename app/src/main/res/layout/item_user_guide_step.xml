<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/tvUgStepNumber"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:background="@drawable/bg_ug_number"
        android:gravity="center"
        android:textColor="@color/ug_number_text"
        android:textSize="13sp"
        android:textStyle="bold"
        tools:text="1" />

    <TextView
        android:id="@+id/tvUgStepText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:lineSpacingExtra="3dp"
        android:paddingTop="2dp"
        android:textColor="@color/ug_body"
        android:textSize="15sp"
        tools:text="On the Home screen, tap Financing Application." />
</LinearLayout>
