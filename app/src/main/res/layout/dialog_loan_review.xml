                android:layout_height="wrap_content"
                android:letterSpacing="0.05"
                android:text="@string/str_occupation_type"
                android:textColor="@color/light_gray_label"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:ignore="SmallSp,SpUsage" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_input_field_selector"
                android:paddingHorizontal="16dp">

                <EditText
                    android:id="@+id/etReviewOccupationType"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:hint="@string/str_occupation_type"
                    android:inputType="text"
                    android:paddingVertical="12dp"
                    android:textColor="@color/dark_navy"
                    android:textColorHint="@color/light_gray_label"
                    android:textSize="15sp" />
            </RelativeLayout>

            <!-- Specific Occupation -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.05"
                android:text="@string/str_specific_occupation"
                android:textColor="@color/light_gray_label"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:ignore="SmallSp,SpUsage" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_input_field_selector"
                android:paddingHorizontal="16dp">

                <EditText
                    android:id="@+id/etReviewSpecificOccupation"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:hint="@string/str_specific_occupation"
                    android:inputType="text"
                    android:paddingVertical="12dp"
                    android:textColor="@color/dark_navy"
                    android:textColorHint="@color/light_gray_label"
                    android:textSize="15sp" />
            </RelativeLayout>
            <!-- Buttons -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal"
                android:weightSum="2">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCancelReview"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="@string/str_cancel"
                    android:textColor="@color/auto_color_475569"
                    app:cornerRadius="8dp"
                    app:strokeColor="@color/auto_color_CBD5E1" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnConfirmReview"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="@string/auto_confirm_amp_fill_768"
                    android:textColor="@color/white"
                    app:backgroundTint="@color/auto_color_2E7D32"
                    app:cornerRadius="8dp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</FrameLayout>
