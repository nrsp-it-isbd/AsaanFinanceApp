<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:tools="http://schemas.android.com/tools" xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
        android:baselineAligned="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingVertical="12dp"
        android:paddingHorizontal="0dp"
        android:divider="@drawable/divider_vertical_light"
        android:showDividers="middle"
        android:baselineAligned="false">

        <TextView
            android:id="@+id/tvInstNo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.8"
            android:gravity="center"
            android:text="@string/str_1"
            android:textColor="@color/auto_color_374151"
            android:textSize="12sp"
            android:textStyle="bold" 
        tools:ignore="SmallSp,SpUsage" />

        <TextView
            android:id="@+id/tvDueDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.2"
            android:gravity="center"
            android:text="@string/auto_2023_01_01_875"
            android:textColor="@color/auto_color_4B5563"
            android:textSize="11sp" 
        tools:ignore="SmallSp,SpUsage" />

        <TextView
            android:id="@+id/tvDueTotal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.2"
            android:gravity="center"
            android:text="@string/auto_5000_876"
            android:textColor="@color/auto_color_1F2937"
            android:textSize="12sp"
            android:textStyle="bold" 
        tools:ignore="SmallSp,SpUsage" />

        <TextView
            android:id="@+id/tvRecDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.2"
            android:gravity="center"
            android:text="@string/auto_2023_01_05_877"
            android:textColor="@color/auto_color_4B5563"
            android:textSize="11sp" 
        tools:ignore="SmallSp,SpUsage" />

        <TextView
            android:id="@+id/tvRecTotal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.2"
            android:gravity="center"
            android:text="@string/auto_5000_876"
            android:textColor="@color/auto_color_10B981"
            android:textSize="12sp"
            android:textStyle="bold" 
        tools:ignore="SmallSp,SpUsage" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/auto_color_E5E7EB" />
</LinearLayout>
