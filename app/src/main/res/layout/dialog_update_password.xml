<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:tools="http://schemas.android.com/tools" xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="24dp"
    android:background="@android:color/transparent"
        tools:ignore="UnusedAttribute">

<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_voice_chat_dialog"
    android:clipToOutline="true"
    android:padding="24dp">

    <!-- Lock/Reset Icon Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cvIcon"
        android:layout_width="56dp"
        android:layout_height="56dp"
        app:cardBackgroundColor="@color/auto_color_E8F5E9"
        app:cardCornerRadius="28dp"
        app:cardElevation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="14dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_baseline_lock_24"
            app:tint="@color/primary" 
        tools:ignore="ContentDescription" />
    </androidx.cardview.widget.CardView>

    <!-- Dialog Title -->
    <TextView
        android:id="@+id/tvDialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:text="@string/str_reset_password"
        android:textColor="@color/auto_color_1F2937"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/cvIcon" 
        tools:ignore="SmallSp,SpUsage" />

    <!-- Dialog Subtitle -->
    <TextView
        android:id="@+id/tvDialogSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:text="@string/str_create_a_new_secure_"
        android:textColor="@color/text_slate_400"
        android:textSize="13sp"
        app:layout_constraintTop_toBottomOf="@id/tvDialogTitle" 
        tools:ignore="SmallSp,SpUsage" />

    <!-- Form Container -->
    <LinearLayout
        android:id="@+id/formContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/tvDialogSubtitle"
        android:baselineAligned="false">

        <!-- Phone Number -->
        <!-- Extracted Hint Label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.05"
            android:text="@string/str_phone_number_1"
            android:textColor="@color/light_gray_label"
            android:textSize="11sp"
            android:textStyle="bold" 
        tools:ignore="SmallSp,SpUsage" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_input_field_selector"
            android:paddingHorizontal="16dp">

            <EditText
                android:id="@+id/editPhoneNumber"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:hint="@string/str_phone_number_1"
                android:inputType="phone"
                android:maxLength="12"
                android:paddingVertical="12dp"

                android:textColor="@color/on_surface"
                android:textColorHint="@color/light_gray_label"
                android:textSize="15sp" />
        </RelativeLayout>

        <!-- New Password -->
        <!-- Extracted Hint Label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.05"
            android:text="@string/str_new_password"
            android:textColor="@color/light_gray_label"
            android:textSize="11sp"
            android:textStyle="bold" 
        tools:ignore="SmallSp,SpUsage" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_input_field_selector"
            android:paddingHorizontal="16dp">

            <EditText
                android:id="@+id/edNewPassword"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:hint="@string/str_new_password"
                android:inputType="numberPassword"
                android:maxLength="4"
                android:paddingVertical="12dp"

                android:textColor="@color/on_surface"
                android:textColorHint="@color/light_gray_label"
                android:textSize="15sp" />
        </RelativeLayout>

        <!-- Confirm Password -->
        <!-- Extracted Hint Label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.05"
            android:text="@string/str_confirm_password"
            android:textColor="@color/light_gray_label"
            android:textSize="11sp"
            android:textStyle="bold" 
        tools:ignore="SmallSp,SpUsage" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_input_field_selector"
            android:paddingHorizontal="16dp">

            <EditText
                android:id="@+id/edNewConfirmPassword"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:hint="@string/str_confirm_password"
                android:inputType="numberPassword"
                android:maxLength="4"
                android:paddingVertical="12dp"
                android:textColor="@color/on_surface"
                android:textColorHint="@color/light_gray_label"
                android:textSize="15sp" />
        </RelativeLayout>

    </LinearLayout>

    <!-- Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/formContainer"
        android:baselineAligned="false">

        <!-- Cancel Button -->
        <TextView
            android:id="@+id/btnBack"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_badge_rounded"
            android:backgroundTint="@color/auto_color_F3F4F6"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/str_cancel"
            android:textColor="@color/auto_color_374151"
            android:textSize="15sp"
            android:textStyle="bold" 
        tools:ignore="SmallSp,SpUsage" />

        <!-- Update Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/updatePasswordButton"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/str_update_password"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            app:cornerRadius="8dp"
            android:backgroundTint="@color/primary" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>
