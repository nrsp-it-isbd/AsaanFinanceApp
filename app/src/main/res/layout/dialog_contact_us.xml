<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:tools="http://schemas.android.com/tools" xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="24dp"
    android:background="@android:color/transparent"
    tools:ignore="UnusedAttribute">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_voice_chat_dialog"
        android:padding="24dp"
        android:clipToOutline="true">

        <!-- Icon Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cvIcon"
            android:layout_width="56dp"
            android:layout_height="56dp"
            app:cardCornerRadius="28dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/auto_color_E1F5FE"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_phone"
                app:tint="@color/auto_color_0277BD"
                tools:ignore="ContentDescription" />
        </androidx.cardview.widget.CardView>

        <!-- Dialog Title -->
        <TextView
            android:id="@+id/tvDialogTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/contact_us_title"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/auto_color_1F2937"
            android:gravity="center"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/cvIcon" 
            tools:ignore="SmallSp,SpUsage" />

        <!-- Content Area -->
        <LinearLayout
            android:id="@+id/llContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/tvDialogTitle">

            <!-- Asaan Finance support (values set from Constants in SettingsFragment) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/contact_support_phone_label"
                android:textColor="@color/light_gray_label"
                android:textSize="12sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tvSupportPhone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:autoLink="phone"
                android:textColor="@color/dark_navy"
                android:textSize="14sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/contact_support_email_label"
                android:textColor="@color/light_gray_label"
                android:textSize="12sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tvSupportEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:autoLink="email"
                android:textColor="@color/dark_navy"
                android:textSize="14sp" />

            <!-- Address -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/contact_address_label"
                android:textColor="@color/light_gray_label"
                android:textSize="12sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/contact_address_value"
                android:textColor="@color/dark_navy"
                android:textSize="14sp" />

            <!-- Tel & Fax Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp"
                android:baselineAligned="false">
                
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/contact_tel_label"
                        android:textColor="@color/light_gray_label"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/contact_tel_value"
                        android:textColor="@color/dark_navy"
                        android:textSize="14sp"
                        android:autoLink="phone" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/contact_fax_label"
                        android:textColor="@color/light_gray_label"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/contact_fax_value"
                        android:textColor="@color/dark_navy"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Email & Website Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp"
                android:baselineAligned="false">
                
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/contact_email_label"
                        android:textColor="@color/light_gray_label"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/contact_email_value"
                        android:textColor="@color/dark_navy"
                        android:textSize="14sp"
                        android:autoLink="email" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/contact_website_label"
                        android:textColor="@color/light_gray_label"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/contact_website_value"
                        android:textColor="@color/dark_navy"
                        android:textSize="14sp"
                        android:autoLink="web" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Close Button -->
        <TextView
            android:id="@+id/btnBack"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/close"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center"
            android:background="@drawable/bg_badge_rounded"
            android:backgroundTint="@color/primary"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/llContent"
            app:layout_constraintBottom_toBottomOf="parent" 
            tools:ignore="SmallSp,SpUsage" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>
