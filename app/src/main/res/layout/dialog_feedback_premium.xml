<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    tools:ignore="UnusedAttribute">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        android:background="@color/surface"
        app:cardCornerRadius="24dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface"
            android:baselineAligned="false"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/feedbackAnim"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_marginBottom="16dp"
                android:src="@drawable/ic_shield_check"
                app:lottie_autoPlay="true"
                app:lottie_loop="false"
                app:lottie_rawRes="@raw/success_anim"
                app:tint="@color/primary" />

            <ImageView
                android:id="@+id/feedbackIcon"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginBottom="16dp"
                android:src="@drawable/ic_alert_circle"
                android:visibility="gone"
                app:tint="@color/status_warning"
                tools:ignore="ContentDescription" />

            <TextView
                android:id="@+id/feedbackTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:fontFamily="sans-serif-black"
                android:text="@string/str_success"
                android:textAlignment="center"
                android:textColor="@color/on_surface"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:ignore="SmallSp,SpUsage" />

            <TextView
                android:id="@+id/feedbackMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp"
                android:alpha="0.7"
                android:gravity="center"
                android:text="@string/str_your_application_has"
                android:textAlignment="center"
                android:textColor="@color/on_surface"
                android:textSize="14sp"
                tools:ignore="SmallSp,SpUsage" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFeedbackAction"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:fontFamily="sans-serif-black"
                android:text="@string/str_done"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="16sp"
                app:backgroundTint="@color/primary"
                app:cornerRadius="16dp" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</FrameLayout>
