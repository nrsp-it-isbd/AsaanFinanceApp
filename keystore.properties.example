# Copy this file to keystore.properties (same folder) and fill in your own values.
# keystore.properties and the .jks file are secret: never share or upload them.
#
# Create the upload key once (keep the .jks and passwords safe; NRSP should own them):
#   keytool -genkeypair -v -keystore asaan-upload.jks -alias asaan-upload -keyalg RSA -keysize 2048 -validity 10000
#
# Then build the file for Play Console:
#   gradlew.bat :app:bundleRelease      ->  app/build/outputs/bundle/release/app-release.aab

storeFile=asaan-upload.jks
storePassword=
keyAlias=asaan-upload
keyPassword=
